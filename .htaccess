DirectoryIndex index.php
Options -MultiViews

<IfModule mod_mime.c>
    AddType application/wasm .wasm
</IfModule>

RewriteEngine On

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType text/javascript "access plus 30 days"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"

    <FilesMatch "\.(?:css|js|jpg|jpeg|png|gif|webp|avif|svg|woff2)$">
        Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
    </FilesMatch>
</IfModule>

# Application internals are never public.
RewriteRule ^(?:config|database|includes|storage|tests|vendor)(?:/|$) website/error.php?code=403 [L,NC]

# Search-engine-facing page routes.
RewriteRule ^properties/?$ website/listing.php [L,QSA]
RewriteRule ^properties/in-([a-z0-9-]+)/?$ website/listing.php?city_slug=$1&seo_route=1 [L,QSA,NC]
RewriteRule ^properties-for-sale(?:/in-([a-z0-9-]+))?/?$ website/listing.php?type=buy&city_slug=$1&seo_route=1 [L,QSA,NC]
RewriteRule ^properties-for-rent(?:/in-([a-z0-9-]+))?/?$ website/listing.php?type=rent&city_slug=$1&seo_route=1 [L,QSA,NC]
RewriteRule ^commercial-properties(?:/in-([a-z0-9-]+))?/?$ website/listing.php?type=commercial&city_slug=$1&seo_route=1 [L,QSA,NC]
RewriteRule ^pg-accommodation(?:/in-([a-z0-9-]+))?/?$ website/listing.php?type=pg&city_slug=$1&seo_route=1 [L,QSA,NC]
RewriteRule ^plots-for-sale(?:/in-([a-z0-9-]+))?/?$ website/listing.php?type=plots&city_slug=$1&seo_route=1 [L,QSA,NC]
RewriteRule ^property/([^/]+)/?$ website/property-details.php?slug=$1 [L,QSA,B]
RewriteRule ^sitemap\.xml$ website/sitemap.php [L]
RewriteRule ^robots\.txt$ website/robots.php [L]

# Public pages and application endpoints remain extensionless.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(account|auth-state|home-localities|lead-status|login|logout|post-property|post-property-description-templates|post-property-draft|post-property-media|property-enquiry|property-preview|property-status|saved-property|track-activity|verify-otp)/?$ website/$1.php [L,QSA,NC]

# All other unknown public routes use the branded not-found response.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ website/error.php?code=404 [L,QSA]
