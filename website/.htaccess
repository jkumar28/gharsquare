DirectoryIndex index.php
Options -MultiViews

RewriteEngine On

# Keep physical frontend assets available while removing this directory from page URLs.
RewriteRule ^assets/ - [L,NC]

RewriteCond %{THE_REQUEST} \s/+.*?/website(?:/[^?\s]*)?[\s?] [NC]
RewriteRule ^$ legacy-redirect.php?route=index [L,QSA]

RewriteCond %{THE_REQUEST} \s/+.*?/website/[^?\s]*[\s?] [NC]
RewriteRule ^(.+?)(?:\.(?:php|html))?/?$ legacy-redirect.php?route=$1 [L,QSA,NC]
